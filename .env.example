# Copy to .env and fill in. Generate each secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# Django signing key. Keep it secret; changing it logs out the admin.
DJANGO_SECRET_KEY=

# Access key for the app. Open http://localhost:8000/?token=<this value> once per browser.
# Anyone with this value can read and change the family tree.
FAMILYTREE_API_TOKEN=

# Hostnames the app answers to (comma-separated). Add your domain when hosting behind a reverse proxy.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
