{
  "name": "familytree-front",
  "version": "0.0.1",
  "private": true,
  "main": "electron.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron electron.js",
    "build-electron": "npm run build && electron-builder"
  },
  "dependencies": {
    "@balkangraph/familytree.js": "^1.9.47",
    "axios": "^1.4.0",
    "d3": "^7.9.0",
    "react": "^18.2.0",
    "react-d3-tree": "^3.0.0",
    "react-dom": "^18.2.0",
    "three": "^0.177.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "vite": "^8.0.8"
  },
  "build": {
    "appId": "com.familytree.app",
    "productName": "FamilyTree",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true
    },
    "files": [
      "dist/**/*",
      "electron.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../dist/familytree_backend.exe",
        "to": "familytree_backend.exe"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/familytree_backend.exe"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "icon": "build/icon.ico"
    },
    "directories": {
      "output": "release"
    }
  }
}
